+    /// Origin note for goal continuations (FT-002).
+    ///
+    /// When the loop continues after an idle turn (via a logged
+    /// continuation `user_message` or a silent `run.idle` refire)
+    /// the model re-encounters its own previous reply and/or the
+    /// original user turn. Without this note the model can misread
+    /// the re-presented text as a new user confirmation and re-post
+    /// its own answer (the exact misread observed in FT-002).
+    ///
+    /// This is static text so the fragment stays a pure function of
+    /// `(goal, id)` and remains byte-stable across turns (P17).
+    pub fn continuation_origin_note() -> &'static str {
+        "Continuation origin: when the loop continues without a new \
+         user message, the text you see again is your own previous reply \
+         and the original user turn, not a new user message. Do not treat \
+         the re-presented turn as a user confirmation or echo your own \
+         reply; continue the goal work instead."
+    }
+
     /// The `run.idle` continuation **message** (port of pi-goal
     /// `buildContinuePrompt`). This text is *logged* as a
     /// `user_message` (conversation side, cache-neutral); the
     /// standing goal block stays out of the log. Contains the goal
     /// text and "continuation #N" where N is [`GoalState::iteration`]
     /// (docs/goal-ux.md §1.1b, P10).
+    ///
+    /// Opens with a hook-origin marker (FT-002): the
+    /// continuation is generated by the goal-continuation hook, not
+    /// typed by the user. Without the marker, a model whose last
+    /// reply ended with a question to the user can read the
+    /// continuation as the user's answer and re-post its own reply.
     pub fn build_continue_prompt(&self) -> String {
         format!(
-            "Goal continuation #{}: \"{}\". The goal is still active. Keep working \
